#!/usr/bin/with-contenv bash

set -euo pipefail

DEFAULT_USER="abc"
RDP_USER="${RDP_USER:-abc}"
RDP_PASSWORD="${RDP_PASSWORD:-abc}"

if [[ -z "${RDP_USER}" ]]; then
  echo "RDP_USER must not be empty"
  exit 1
fi

if [[ -z "${RDP_PASSWORD}" ]]; then
  echo "RDP_PASSWORD must not be empty"
  exit 1
fi

if [[ ! "${RDP_USER}" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]]; then
  echo "RDP_USER '${RDP_USER}' is not a valid Linux username"
  exit 1
fi

target_user="${DEFAULT_USER}"

if [[ "${RDP_USER}" != "${DEFAULT_USER}" ]]; then
  if id "${RDP_USER}" >/dev/null 2>&1; then
    target_user="${RDP_USER}"
  else
    if ! id "${DEFAULT_USER}" >/dev/null 2>&1; then
      echo "Default RDP user '${DEFAULT_USER}' does not exist and '${RDP_USER}' has not been created"
      exit 1
    fi

    if getent group "${DEFAULT_USER}" >/dev/null 2>&1 && ! getent group "${RDP_USER}" >/dev/null 2>&1; then
      groupmod -n "${RDP_USER}" "${DEFAULT_USER}"
    fi

    usermod -l "${RDP_USER}" "${DEFAULT_USER}"
    usermod -d /config "${RDP_USER}"

    if getent group "${RDP_USER}" >/dev/null 2>&1; then
      usermod -g "${RDP_USER}" "${RDP_USER}"
    fi

    if [[ -f "/etc/sudoers.d/${DEFAULT_USER}" ]]; then
      mv "/etc/sudoers.d/${DEFAULT_USER}" "/etc/sudoers.d/${RDP_USER}"
      sed -i "s/^${DEFAULT_USER}\\b/${RDP_USER}/" "/etc/sudoers.d/${RDP_USER}"
    fi

    target_user="${RDP_USER}"
  fi
fi

printf '%s:%s\n' "${target_user}" "${RDP_PASSWORD}" | chpasswd
echo "RDP credentials configured for user '${target_user}'"
